# GA4 measurement ID is set in src/lib/analytics.ts (G-CELWZ8FRQG).

# Resend — required for /api/contact delivery (server only; never expose to the client).
RESEND_API_KEY=
# Verified sender in Resend (e.g. "Dialed In Electric <leads@your-verified-domain.com>").
# Do not use an unverified domain; Resend will reject sends.
RESEND_FROM_EMAIL=

# Optional override for notification recipient (defaults to Dialedinelectric@gmail.com).
# LEAD_INBOX_EMAIL=Dialedinelectric@gmail.com